# Fastfile — WSLCRM iOS release (GitHub Actions + Vault + fastlane).
#
# The same pipeline as Fishers: CI signs with an App Store Connect API key whose
# values come from GitHub Actions secrets or WSLVault (scripts/ci/load-ios-secrets.sh),
# then
#   ci_build_number → prepare_signing → build_ipa → beta (TestFlight)
# See .github/workflows/ios_release.yml and docs/IOS_RELEASE.md.

default_platform(:ios)

APP_ID = "uk.co.workstation.wslcrm".freeze
PROJECT = "WSLCRM.xcodeproj".freeze
TARGET = "WSLCRM".freeze

# Testers get the DBS Ltd build against int by default: the DBS Group demo workspace is
# seeded there. RELEASE_SCHEME / RELEASE_CONFIGURATION pick another (e.g. WSLCRM-Int).
DEFAULT_SCHEME = "WSLCRM-DBS-Int".freeze
DEFAULT_CONFIGURATION = "Release-DBS-Int".freeze

# Every main merge makes these emails internal testers on "WSLCRM Team" — App Store
# Connect team members, so builds install with no Beta App Review. Override with the
# TESTFLIGHT_TESTERS repo variable (comma-separated).
DEFAULT_TESTFLIGHT_TESTERS = [
  "balindersinghwalia@icloud.com",
  "harchran001@gmail.com"
].freeze
INTERNAL_TESTFLIGHT_GROUP = "WSLCRM Team".freeze
DEFAULT_EXTERNAL_GROUP = "WSLCRM".freeze

# Only internal testers skip Beta App Review, and only App Store Connect team members can be
# internal testers. Marketing is the least privilege that still counts, limited to this app.
ASC_TESTER_ROLE = "MARKETING".freeze

def release_scheme
  ENV.fetch("RELEASE_SCHEME", "").strip.then { |s| s.empty? ? DEFAULT_SCHEME : s }
end

def release_configuration
  ENV.fetch("RELEASE_CONFIGURATION", "").strip.then { |s| s.empty? ? DEFAULT_CONFIGURATION : s }
end

def team_id
  ENV.fetch("APPLE_TEAM_ID") do
    UI.user_error!("APPLE_TEAM_ID is not set — add it to WSLVault kv/wslcrm/ios or GitHub secrets")
  end
end

def asc_api_key
  # duration 500 avoids a Spaceship JWT skew issue where App Store Connect rejects the
  # default 1200 as an invalid bearer token (fastlane/fastlane#29468, #21109).
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID").to_s.strip,
    issuer_id: ENV.fetch("ASC_ISSUER_ID").to_s.strip,
    key_filepath: ENV.fetch("ASC_KEY_FILEPATH").to_s.strip,
    duration: 500,
    in_house: false
  )
end

def spaceship_token_from!(api_key)
  require "spaceship"
  token_args = {
    key_id: api_key[:key_id] || api_key["key_id"],
    issuer_id: api_key[:issuer_id] || api_key["issuer_id"],
    duration: 500,
    in_house: false
  }
  if api_key[:key] || api_key["key"]
    token_args[:key] = api_key[:key] || api_key["key"]
  else
    token_args[:filepath] = api_key[:key_filepath] || api_key[:filepath] || ENV["ASC_KEY_FILEPATH"]
  end
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**token_args)
end

def generate_xcode_project!
  sh("xcodegen", "generate", "--spec", File.expand_path("../project.yml", __dir__))
end

def emit_github(file_env_var, line)
  path = ENV[file_env_var]
  File.write(path, "#{line}\n", mode: "a") if path && !path.empty?
end

def ipa_output_dir
  File.expand_path("../build/release", __dir__)
end

def ipa_output_path
  File.join(ipa_output_dir, "WSLCRM.ipa")
end

def write_export_options(path, app_profile)
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>method</key>
    \t<string>app-store-connect</string>
    \t<key>teamID</key>
    \t<string>#{team_id}</string>
    \t<key>signingStyle</key>
    \t<string>manual</string>
    \t<key>uploadSymbols</key>
    \t<true/>
    \t<key>stripSwiftSymbols</key>
    \t<true/>
    \t<key>manageAppVersionAndBuildNumber</key>
    \t<false/>
    \t<key>provisioningProfiles</key>
    \t<dict>
    \t\t<key>#{APP_ID}</key>
    \t\t<string>#{app_profile}</string>
    \t</dict>
    </dict>
    </plist>
  PLIST
end

# MARK: - TestFlight testers

def testflight_tester_emails
  raw = ENV["TESTFLIGHT_TESTERS"].to_s.strip
  list = raw.empty? ? DEFAULT_TESTFLIGHT_TESTERS : raw.split(/[,\s]+/).map(&:strip).reject(&:empty?)
  list.map(&:downcase).uniq
end

def external_group_name
  ENV.fetch("TESTFLIGHT_GROUP", "").strip.then { |s| s.empty? ? DEFAULT_EXTERNAL_GROUP : s }
end

def wslcrm_app!
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  unless app
    UI.user_error!(
      "App Store Connect has no app for #{APP_ID}. Create it once (Apps → + → New App, " \
      "bundle id #{APP_ID}) — Apple's API cannot — then re-run. See docs/IOS_RELEASE.md."
    )
  end
  app
end

def find_or_create_beta_group!(app:, name:, internal:)
  find = lambda do
    Array(app.get_beta_groups(filter: { name: name })).find { |g| g.name == name } ||
      Array(app.get_beta_groups).find { |g| g.name == name }
  end
  existing = find.call
  return existing if existing&.id

  UI.message("Creating #{internal ? 'internal' : 'external'} TestFlight group '#{name}'")
  if internal
    # Internal groups reject publicLink* attributes — post a minimal body.
    body = {
      data: {
        type: "betaGroups",
        attributes: { name: name, isInternalGroup: true, hasAccessToAllBuilds: true },
        relationships: { app: { data: { type: "apps", id: app.id } } }
      }
    }
    Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaGroups", body)
  else
    Spaceship::ConnectAPI.create_beta_group(
      app_id: app.id,
      group_name: name,
      is_internal_group: false,
      public_link_enabled: true,
      public_link_limit: 10_000,
      public_link_limit_enabled: false
    )
  end
  group = find.call
  UI.user_error!("Could not create or load TestFlight group '#{name}'") unless group&.id
  group
end

def internal_group!(app:)
  find_or_create_beta_group!(app: app, name: INTERNAL_TESTFLIGHT_GROUP, internal: true)
end

def external_group!(app:)
  group = find_or_create_beta_group!(app: app, name: external_group_name, internal: false)
  link = group.respond_to?(:public_link) ? group.public_link.to_s : ""
  UI.success("TestFlight public link: #{link}") unless link.empty?
  emit_github("GITHUB_STEP_SUMMARY", "- Public TestFlight link: #{link}") unless link.empty?
  group
end

def beta_testers_for(app:, email:)
  Array(
    Spaceship::ConnectAPI.get_beta_testers(filter: { email: email, apps: app.id }, includes: "betaGroups").all_pages
  ).flat_map(&:to_models).uniq(&:id)
rescue => e
  UI.message("get_beta_testers(#{email}): #{e.message}")
  []
end

def assign_tester!(group:, email:)
  Spaceship::ConnectAPI.post_beta_tester_assignment(
    beta_group_ids: [group.id],
    attributes: { email: email, firstName: email.split("@").first.to_s[0, 30], lastName: "Tester" }
  )
  UI.success("Assigned #{email} to TestFlight group '#{group.name}'")
  true
rescue => e
  if e.message.to_s =~ /already|exists|conflict|cannot be assigned|ENTITY_ERROR/i
    UI.message("#{email} already on '#{group.name}'")
    true
  else
    UI.important("Assign #{email} to '#{group.name}': #{e.message}")
    false
  end
end

# The "You're invited to test" email — not Apple's "build has completed processing" mail,
# which goes to the developer account.
def send_invitation!(app:, email:)
  tester = beta_testers_for(app: app, email: email).first
  return UI.important("No beta tester record for #{email} yet") unless tester&.id

  body = {
    data: {
      type: "betaTesterInvitations",
      relationships: {
        app: { data: { type: "apps", id: app.id } },
        betaTester: { data: { type: "betaTesters", id: tester.id } }
      }
    }
  }
  Spaceship::ConnectAPI.client.test_flight_request_client.post("v1/betaTesterInvitations", body)
  UI.success("Invite sent to #{email}")
rescue => e
  UI.message("Invite for #{email}: #{e.message} (they may already have accepted)")
end

def team_member_state!(app:, email:)
  member = Array(Spaceship::ConnectAPI::User.all).find do |u|
    [u.username, u.email].compact.map { |s| s.to_s.downcase }.include?(email)
  end
  return :member if member
  return :invited if Array(Spaceship::ConnectAPI::UserInvitation.all).any? { |i| i.email.to_s.downcase == email }

  local = email.split("@").first.to_s.gsub(/[^A-Za-z0-9]/, " ").strip
  Spaceship::ConnectAPI::UserInvitation.create(
    email: email,
    first_name: (local.empty? ? "WSLCRM" : local)[0, 30],
    last_name: "Tester",
    roles: [ASC_TESTER_ROLE],
    provisioning_allowed: false,
    all_apps_visible: false,
    visible_app_ids: [app.id]
  )
  UI.success("Invited #{email} to the App Store Connect team (#{ASC_TESTER_ROLE}, WSLCRM only)")
  :invited
rescue => e
  UI.important("App Store Connect team invite for #{email} failed: #{e.message} " \
               "(inviting users needs an Admin API key)")
  :failed
end

# Internal testers install as soon as a build finishes processing. Anyone not yet on the
# team is also put on the external group, which installs after Beta App Review.
def invite_testers!(app:, external:)
  internal = internal_group!(app: app)
  states = testflight_tester_emails.to_h do |email|
    state = team_member_state!(app: app, email: email)
    if state == :member
      assign_tester!(group: internal, email: email)
    else
      assign_tester!(group: external, email: email)
    end
    sleep(2)
    send_invitation!(app: app, email: email)
    [email, state]
  end

  emit_github("GITHUB_STEP_SUMMARY", "### TestFlight testers")
  notes = {
    member: "internal tester — installs from TestFlight now, no review",
    invited: "App Store Connect team invite pending — accept that email, then run the workflow with target invite_testers",
    failed: "team invite failed (see log); on the external group meanwhile"
  }
  states.each do |email, state|
    UI.message("  #{email}: #{state}")
    emit_github("GITHUB_STEP_SUMMARY", "- #{email}: #{notes[state]}")
  end
end

def latest_valid_build(app:)
  Array(
    Spaceship::ConnectAPI.get_builds(
      filter: { app: app.id, processingState: "VALID" }, sort: "-uploadedDate", limit: 5, includes: nil
    )
  ).first
end

def attach_build!(build:, group:, label:)
  Spaceship::ConnectAPI.add_beta_groups_to_build(build_id: build.id, beta_group_ids: [group.id])
  UI.success("Build #{build.version} attached to #{label}")
rescue => e
  if e.message.to_s =~ /already|exists|conflict/i
    UI.message("Build #{build.version} already on #{label}")
  else
    UI.important("Attach build to #{label} failed: #{e.message}")
  end
end

def distribute_latest_build!(app:, external:)
  build = latest_valid_build(app: app)
  return UI.important("No processed TestFlight build to distribute yet") unless build&.id

  internal = internal_group!(app: app)
  attach_build!(build: build, group: internal, label: "internal '#{internal.name}'") unless internal.has_access_to_all_builds
  attach_build!(build: build, group: external, label: "external '#{external.name}'")
  build
end

def beta_review_in_progress?(app:)
  recent = Spaceship::ConnectAPI.get_builds(filter: { app: app.id }, includes: nil, sort: "-uploadedDate", limit: 20)
  ids = Array(recent.to_models).map(&:id).compact
  return false if ids.empty?

  Array(Spaceship::ConnectAPI.get_beta_app_review_submissions(filter: { build: ids.join(",") }).all_pages)
    .flat_map(&:to_models)
    .any? { |s| s.respond_to?(:beta_review_state) && s.beta_review_state.to_s =~ /WAITING_FOR_REVIEW|IN_REVIEW/ }
rescue => e
  UI.message("Could not list Beta App Review submissions (#{e.message})")
  false
end

# The app signs in before it does anything, so Apple's reviewers need an account. Without
# TESTFLIGHT_DEMO_USER / TESTFLIGHT_DEMO_PASSWORD the external review is skipped: internal
# testers are unaffected, and a review that is bound to be rejected is not sent.
def submit_external_review!(key:, app:, external:)
  user = ENV["TESTFLIGHT_DEMO_USER"].to_s.strip
  password = ENV["TESTFLIGHT_DEMO_PASSWORD"].to_s
  if user.empty? || password.empty?
    UI.important("No TESTFLIGHT_DEMO_USER / TESTFLIGHT_DEMO_PASSWORD — skipping Beta App Review " \
                 "(external testers wait; internal testers install now)")
    return false
  end
  if beta_review_in_progress?(app: app)
    UI.message("A build is already in Beta App Review — leaving it to finish")
    return false
  end

  description = ENV.fetch(
    "TESTFLIGHT_BETA_DESCRIPTION",
    "WSLCRM is a field-service and work-management app: engineers' visits, jobs, " \
    "project boards and timesheets."
  )
  upload_to_testflight(
    api_key: key,
    distribute_only: true,
    app_identifier: APP_ID,
    app_platform: "ios",
    distribute_external: true,
    submit_beta_review: true,
    notify_external_testers: true,
    groups: [external.name],
    changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "WSLCRM TestFlight build — please install and smoke-test."),
    beta_app_description: description,
    beta_app_feedback_email: testflight_tester_emails.first,
    demo_account_required: true,
    uses_non_exempt_encryption: false,
    reject_build_waiting_for_review: false,
    beta_app_review_info: {
      contact_email: ENV.fetch("TESTFLIGHT_CONTACT_EMAIL", testflight_tester_emails.first),
      contact_first_name: ENV.fetch("TESTFLIGHT_CONTACT_FIRST_NAME", "Balinder"),
      contact_last_name: ENV.fetch("TESTFLIGHT_CONTACT_LAST_NAME", "Walia"),
      contact_phone: ENV.fetch("TESTFLIGHT_CONTACT_PHONE", ""),
      demo_account_name: user,
      demo_account_password: password,
      demo_account_required: true,
      notes: ENV.fetch(
        "TESTFLIGHT_REVIEW_NOTES",
        "Sign in with the demo account; it opens the DBS Group demo workspace on our integration server."
      )
    },
    localized_app_info: { "en-GB": { feedback_email: testflight_tester_emails.first, description: description } }
  )
  UI.success("Submitted the latest build to '#{external.name}' for Beta App Review")
  true
rescue => e
  UI.important("External review not submitted: #{e.message}")
  false
end

def hand_out_latest_build!(key:)
  spaceship_token_from!(key)
  app = wslcrm_app!
  external = external_group!(app: app)
  # Attach first: Apple refuses invites while the group has no installable build.
  distribute_latest_build!(app: app, external: external)
  submit_external_review!(key: key, app: app, external: external)
  invite_testers!(app: app, external: external)
end

# MARK: - Lanes

platform :ios do
  desc "Generate the project and run the unit tests on a Simulator"
  lane :test do
    generate_xcode_project!
    run_tests(project: PROJECT, scheme: "WSLCRM-Int", only_testing: ["WSLCRMTests"], clean: true)
  end

  desc "Print the next TestFlight build number for VERSION_NAME to GITHUB_OUTPUT"
  lane :ci_build_number do
    version = ENV.fetch("VERSION_NAME")
    latest = latest_testflight_build_number(
      api_key: asc_api_key, app_identifier: APP_ID, version: version, initial_build_number: 0
    )
    nxt = latest.to_i + 1
    UI.message("Latest TestFlight build for #{version} is #{latest}; next is #{nxt}")
    emit_github("GITHUB_OUTPUT", "build_number=#{nxt}")
  end

  desc "Provision code signing from the ASC API key into the persistent signing keychain"
  lane :prepare_signing do
    generate_xcode_project!

    api_key = asc_api_key
    kc_path = ENV.fetch("BUILD_KEYCHAIN_PATH")
    kc_pass = ENV.fetch("BUILD_KEYCHAIN_PASSWORD")
    tmp_dir = ENV["RUNNER_TEMP"] || Dir.pwd

    if File.exist?(kc_path)
      unlock_keychain(path: kc_path, password: kc_pass, set_default: false)
    else
      create_keychain(path: kc_path, password: kc_pass, default_keychain: false, unlock: true,
                      timeout: 3600, add_to_search_list: true)
    end
    sh("security", "list-keychains", "-d", "user", "-s", kc_path,
       File.expand_path("~/Library/Keychains/login.keychain-db"))
    sh("security", "set-keychain-settings", kc_path)

    # Reuses the Apple Distribution certificate already in the keychain when there is one;
    # Apple caps how many a team may have.
    cert(api_key: api_key, keychain_path: kc_path, keychain_password: kc_pass, output_path: tmp_dir)
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID)
    profile_name = lane_context[SharedValues::SIGH_NAME]
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    emit_github("GITHUB_ENV", "INSTALLED_PROFILE_PATH=#{profile_path}") if profile_path

    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: APP_ID,
      targets: [TARGET],
      build_configurations: [release_configuration]
    )

    out = ENV.fetch("EXPORT_OPTIONS_PLIST", File.join(tmp_dir, "ExportOptions.plist"))
    write_export_options(out, profile_name)
    UI.success("Signing ready for #{release_configuration} — ExportOptions at #{out}")
  end

  desc "Archive and export a signed App Store IPA"
  lane :build_ipa do
    # Passed as build settings, not via increment_version_number: agvtool can't resolve the
    # per-configuration $(WSLCRM_INFOPLIST_FILE) and leaves the version where a file path
    # belongs. The Info.plist is generated from these settings anyway.
    version = ENV["VERSION_NAME"].to_s
    settings = ["CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}"]
    settings << "MARKETING_VERSION=#{version}" unless version.empty?

    build_app(
      project: PROJECT,
      scheme: release_scheme,
      configuration: release_configuration,
      xcargs: settings.join(" "),
      export_method: "app-store",
      export_options: ENV.fetch("EXPORT_OPTIONS_PLIST"),
      output_directory: ipa_output_dir,
      output_name: "WSLCRM.ipa",
      clean: true
    )
  end

  desc "Upload the IPA to TestFlight, then hand it to the testers"
  lane :beta do
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path
    UI.user_error!("No IPA at #{ipa}") unless File.exist?(ipa)

    key = asc_api_key
    upload_to_testflight(
      api_key: key,
      ipa: ipa,
      app_identifier: APP_ID,
      app_platform: "ios",
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      submit_beta_review: false,
      notify_external_testers: false,
      uses_non_exempt_encryption: false
    )
    hand_out_latest_build!(key: key)
    UI.success("Build uploaded and handed to #{testflight_tester_emails.join(', ')}")
  end

  desc "Re-distribute the latest processed build and re-invite testers (no upload)"
  lane :invite_testers do
    hand_out_latest_build!(key: asc_api_key)
  end

  desc "Submit the latest build for App Store review (manual release gate)"
  lane :release do
    key = asc_api_key
    ipa = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH] || ipa_output_path
    upload_to_testflight(api_key: key, ipa: ipa, app_identifier: APP_ID, app_platform: "ios",
                         skip_waiting_for_build_processing: true)
    deliver(
      api_key: key,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end
end
