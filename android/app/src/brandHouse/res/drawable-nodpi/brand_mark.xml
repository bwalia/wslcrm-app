<?xml version="1.0" encoding="utf-8"?>
<!-- The house brand has no artwork: BrandMark draws the Handyman icon in the brand colour instead
     (BuildConfig.BRAND_HAS_MARK is false). This transparent shape only keeps R.drawable.brand_mark
     defined in every flavour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
