// Local OPSAPI (Docker) for Simulator testing — Debug only, never shipped.
// The Simulator shares the Mac's network, so 127.0.0.1 reaches the container.
// Override the port in Config/Local.xcconfig: LOCAL_API_PORT = 4020

LOCAL_API_PORT = 4011
API_BASE_URL = http:/$()/127.0.0.1:$(LOCAL_API_PORT)
API_ENVIRONMENT_NAME = Local
WSLCRM_INFOPLIST_FILE = WSLCRM/Resources/Info-Local.plist

// The local stack is where the DBS Ltd demo runs, so this configuration carries its brand.
// Local.xcconfig can override any BRAND_* value (e.g. BRAND_NAME = WSLCRM).
#include "Brand-DBS.xcconfig"

#include? "Local.xcconfig"
