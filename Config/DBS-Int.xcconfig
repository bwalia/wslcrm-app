// DBS Ltd demo, running against the shared int environment.
//
// Same host as Config/Int.xcconfig, different brand: Int stays house-branded so normal
// integration testing looks like WSLCRM, and this configuration is the one to build and
// screenshot for DBS. The demo workspace on int is "DBS Group" (slug dbs-group-demo);
// sign-in details are written to build/<slug>.env by scripts/seed-dbs-limited.py.
//
// Note: `//` starts a comment in xcconfig files, so URLs are written as https:/$()/host.

API_BASE_URL = https:/$()/int-opsapi.workstation.co.uk
WSLCRM_INFOPLIST_FILE = WSLCRM/Resources/Info.plist
API_ENVIRONMENT_NAME = Int

// White-label: DBS Ltd. See Config/Brand-DBS.xcconfig.
#include "Brand-DBS.xcconfig"

// Optional, git-ignored overrides (e.g. DEVELOPMENT_TEAM for device builds).
#include? "Local.xcconfig"
